kprobe:bpf_map_lookup_elem
{
  @lookup_start[tid] = nsecs;
  @lookup_calls = count();
}

kretprobe:bpf_map_lookup_elem
/@lookup_start[tid]/
{
  $delta = nsecs - @lookup_start[tid];
  @lookup_latency_ns = hist($delta);
  if ($delta > 1000) {
    @slow_lookups = count();
  }
  delete(@lookup_start[tid]);
}

END
{
  print(@lookup_calls);
  print(@slow_lookups);
  print(@lookup_latency_ns);
}
