# Ignore compiled BPF objects and build artifacts
/bpf/*.o
*.o
*.out

# Ignore Python envs and caches
venv/
.venv/
env/
__pycache__/
*.pyc

# Ignore IDE/editor files
.vscode/
.idea/
*.swp
*~

# Ignore system files
.DS_Store

# Ignore temporary and log files
*.log
*.tmp

# Keep benchmark/server logs under results tracked so they are visible after pull
!ebpf_research/results/*.log
!ebpf_research/results/**/*.log
!ebpf_research/results/**/redis_broker.log
!ebpf_research/results/**/worker_*.log
!ebpf_research/results/**/adv_storm.log
!ebpf_research/results/**/bpftrace_redis_dict.log
!ebpf_research/results/**/socat_*.log

# Keep results and plots tracked (do NOT ignore results/ or plots/)
# If you create a local results folder, do not add it to gitignore.
